; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="endless battle"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameSettings="*res://autoloads/game_settings.gd"
ResourceManager="*res://autoloads/resource_manager.gd"
EnemyResourceManager="*res://autoloads/enemy_resource_manager.gd"
TechTree="*res://autoloads/tech_tree.gd"
UpgradeManager="*res://autoloads/upgrade_manager.gd"
FormationManager="*res://autoloads/formation_manager.gd"
SharedSquadNavigation="*res://scripts/systems/shared_squad_navigation.gd"
PlayerRouteNavigation="*res://scripts/systems/player_route_navigation.gd"
InputManager="*res://autoloads/input_manager.gd"
ControlGroupManager="*res://autoloads/control_group_manager.gd"
CommandFeedback="*res://autoloads/command_feedback.gd"
DeathEffects="*res://autoloads/death_effects.gd"
ImpactEffects="*res://autoloads/impact_effects.gd"
MatchSession="*res://autoloads/match_session.gd"
EntityRegistry="*res://scripts/systems/entity_registry.gd"
AIHeroMastery="*res://scripts/systems/ai_hero_mastery.gd"
HeroAbilityTargetingController="*res://autoloads/hero_ability_targeting_controller.gd"
TooltipManager="*res://scripts/ui/tooltip_manager.gd"
PerfCounters="*res://scripts/debug/perf_counters.gd"
PerfDebugOverlay="*res://scripts/debug/perf_debug_overlay.gd"
RtsAiDebugOverlay="*res://scripts/debug/rts_ai_debug_overlay.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="units"
3d_physics/layer_3="buildings"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
